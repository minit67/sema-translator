# Self-hosted SFU — same shared secret the SFU, egress, and FastAPI already use.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Used for STT (Phase 1), translation + TTS (later phases)
OPENAI_API_KEY=

# Explicit dispatch: identifies this worker so a room/token can request it by name
# instead of the agent auto-joining every room. Room itself is NOT set here —
# it comes from whichever room the dispatch targets at runtime.
AGENT_NAME=sema-interpreter-agent
